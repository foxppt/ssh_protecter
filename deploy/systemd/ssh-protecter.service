[Unit]
Description=SSH TOTP authorization service
Requires=ssh-protecter-guard.service
After=ssh-protecter-guard.service network.target time-sync.target
Wants=time-sync.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/sbin/ssh-protecter serve --config /etc/ssh-protecter/config.yaml --snapshot /etc/ssh-protecter/bootstrap.json
ExecReload=/usr/local/sbin/ssh-protecter reload --socket /run/ssh-protecter/admin.sock
Restart=always
RestartSec=5s
WatchdogSec=45s
TimeoutAbortSec=5s
LimitCORE=0
TimeoutStartSec=30s
TimeoutStopSec=10s
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run /var/lib/ssh-protecter /etc/ssh-protecter

[Install]
WantedBy=multi-user.target
